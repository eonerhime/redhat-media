# Copy to .env.local for local development. Never commit real values.
# Variables are added in the phase that first uses them; the full list and
# rules live in specs/tech-stack.md -> Environment variables.

# Canonical origin. Required in production; previews fall back to the branch
# URL and local dev to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Database (Phase 7). Local values come from the Neon dev branch: run
# scripts/db-bootstrap.mts --branch dev --dev and copy from .env.neon-dev.local.
# Runtime: rhm_app role, pooled host, sslmode=require (checked by lib/env.ts).
# Required on Vercel previews and production.
DATABASE_URL=
# Prisma CLI (migrate dev, studio): rhm_migrator role, direct host. Local only:
# CI holds its own copy, and the Vercel build fails if this is set there.
MIGRATOR_DATABASE_URL=
# Random, 32+ characters; salts rate-limit key hashes. Required on Vercel.
RATE_LIMIT_SALT=

# Cloudinary (Phase 8). Public, not a secret: it appears in every image URL.
# Required on Vercel previews and production.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Local only (Phase 9 spec, D6): read by `pnpm media:upload-seed`, never by the
# app. Not on Vercel or in CI until Phase 28. The key is not secret; the secret
# is, so it never takes a NEXT_PUBLIC_ name. Type it in; don't paste it in chat.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inquiry form (Phase 18 spec, D5, D10). 1 = on; on in Vercel Production from
# the Phase 20 release. Wherever it is on, both Turnstile keys are required. These are
# Cloudflare's public test keys (always pass); only Vercel Production holds the
# real widget's keys, and lib/env.ts refuses the test keys there.
INQUIRY_FORM_ENABLED=1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email (Phase 20 spec, D8, D9). Leave RESEND_API_KEY empty locally: every send is
# then skipped and logged, as in CI. Vercel Production and Preview each hold their
# own sending-only key, with EMAIL_FROM and INQUIRY_NOTIFICATION_EMAIL (required
# there while the form is on). Preview also sets INQUIRY_ACK_ENABLED=1 and
# EMAIL_REDIRECT_TO=delivered@resend.dev. If you do set a key here, set the
# redirect too, or test sends reach the team inbox.
RESEND_API_KEY=
EMAIL_FROM=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_ACK_ENABLED=
EMAIL_REDIRECT_TO=

# Staff sign-in and /cms (Phase 24 spec, D11). 1 = on: Vercel Preview, CI and local.
# Unset in Vercel Production until the Milestone 3 release (lib/env.ts refuses it
# there). Wherever it is on, BETTER_AUTH_SECRET is required: random, 32+ characters,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CMS_ENABLED=1
BETTER_AUTH_SECRET=

# Database tests (pnpm test:db), e.g. against Docker postgres:17 after
# bootstrap + `pnpm db:deploy`. See lib/db/test-client.ts.
TEST_APP_DATABASE_URL=
TEST_MIGRATOR_DATABASE_URL=
TEST_READONLY_DATABASE_URL=
