# Copy to .env.local for local development. Never commit real values.
# Variables are added in the phase that first uses them; the full list and
# rules live in specs/tech-stack.md -> Environment variables.

# Canonical origin. Required in production; previews fall back to the branch
# URL and local dev to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Database (Phase 7). Local values come from the Neon dev branch: run
# scripts/db-bootstrap.mts --branch dev --dev and copy from .env.neon-dev.local.
# Runtime: rhm_app role, pooled host, sslmode=require (checked by lib/env.ts).
# Required on Vercel previews and production.
DATABASE_URL=
# Prisma CLI (migrate dev, studio): rhm_migrator role, direct host. Local only:
# CI holds its own copy, and the Vercel build fails if this is set there.
MIGRATOR_DATABASE_URL=
# Random, 32+ characters; salts rate-limit key hashes. Required on Vercel.
RATE_LIMIT_SALT=

# Cloudinary (Phase 8). Public, not a secret: it appears in every image URL.
# Required on Vercel previews and production. The API key and secret arrive in
# Phase 9 (local seed only) and Phase 28 (Vercel); never put the secret here
# under a NEXT_PUBLIC_ name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Database tests (pnpm test:db), e.g. against Docker postgres:17 after
# bootstrap + `pnpm db:deploy`. See lib/db/test-client.ts.
TEST_APP_DATABASE_URL=
TEST_MIGRATOR_DATABASE_URL=
TEST_READONLY_DATABASE_URL=
