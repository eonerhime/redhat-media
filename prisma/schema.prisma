// Phase 7 spec, D5. Models match README §5; each later model arrives in the
// phase that first needs it. Connection URLs live in prisma.config.ts (CLI)
// and lib/db.ts (runtime), never here.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Six services only: BRANDING is not offered (owner, 2026-10-10; roadmap open question 6).
enum ServiceCategory {
  WEB_APP
  PHOTOGRAPHY
  VIDEOGRAPHY
  DIGITAL_MARKETING
  SOCIAL_MEDIA
  ONLINE_PRESENCE
}

enum InquiryStatus {
  NEW
  REVIEWING
  PROPOSAL_SENT
  CLOSED
}

// Naira bands; labels (with a USD hint) are copy (Phase 17 spec, D2).
enum BudgetRange {
  UNDER_500K
  FROM_500K_TO_1_5M
  FROM_1_5M_TO_5M
  FROM_5M_TO_15M
  OVER_15M
  NOT_SURE
}

enum InquiryTimeline {
  ASAP
  WITHIN_1_MONTH
  ONE_TO_THREE_MONTHS
  OVER_THREE_MONTHS
  FLEXIBLE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum VideoProvider {
  YOUTUBE
  VIMEO
}

enum MediaOwner {
  PORTFOLIO_ITEM
  SERVICE
  PAGE
}

model PortfolioItem {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  category    ServiceCategory
  summary     String
  description String
  client      String?
  credit      String? // e.g. "Technical lead: Emo Onerhime"
  creditUrl   String? // https only; links the credit (Phase 12 spec, D8)
  highlights  String[] // architecture / outcome bullets
  liveUrl     String? // https only
  repoUrl     String? // public repositories only
  techStack   String[] // e.g. ["Next.js", "TypeScript", "Tailwind CSS"]
  featured    Boolean         @default(false)
  published   Boolean         @default(false)
  publishedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // media: MediaItem rows with ownerType = PORTFOLIO_ITEM, ownerId = id
}

model MediaItem {
  id            String         @id @default(cuid())
  ownerType     MediaOwner
  ownerId       String // portfolio item id, ServiceCategory value, or page slot key
  kind          MediaKind
  cloudinaryId  String?
  videoProvider VideoProvider?
  videoId       String?
  videoUrl      String?
  thumbnailUrl  String?
  alt           String?
  title         String?
  caption       String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerType, ownerId, sortOrder])
}

// Phase 17 spec, D1. Written only through toInquiryData (lib/validation/inquiry.ts),
// which applies the Zod length caps. rhm_readonly has no access (D4).
model Inquiry {
  id           String            @id @default(cuid())
  clientName   String
  companyName  String?
  email        String
  phone        String // required; E.164 (D6)
  services     ServiceCategory[] // at least one, enforced by Zod
  projectTypes String[]          @default([]) // CATEGORY.TYPE ids from content/project-types.ts (Phase 19)
  budgetRange  BudgetRange? // required by Zod from Phase 19; null on Phase 18 rows
  timeline     InquiryTimeline? // required by Zod from Phase 19; null on Phase 18 rows
  projectNotes String
  status       InquiryStatus     @default(NEW)
  consentAt    DateTime // privacy-notice consent (NDPA 2023)
  emailSentAt  DateTime? // team notification (Phase 20)
  ackSentAt    DateTime? // client acknowledgment (Phase 20)
  closedAt     DateTime? // the retention clock; set on close, cleared on reopen (Phase 23 spec, D5)
  anonymisedAt DateTime? // set by the retention job (Phase 23 spec, D6)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Shared fixed-window rate limiter (lib/security/rate-limit.ts, Phase 7 spec D8).
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String // e.g. "redhat.inquiry", "redhat.cms.mutation"
  keyHash   String // SHA-256(RATE_LIMIT_SALT + key), 64 hex characters
  windowEnd DateTime
  count     Int      @default(1)

  @@unique([bucket, keyHash, windowEnd])
  @@index([windowEnd])
}
