{
  "name": "redhat-media",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "media:upload-seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upload-seed-media.mts",
    "prepare": "node scripts/install-hooks.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.2",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "1.0.12",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.2",
    "next-cloudinary": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@prisma/adapter-pg": "7.10.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cloudinary": "2.11.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
